# Privexa local configuration. Copy to .env (scripts/setup.py does this) — never commit .env.
# All values below are non-secret local placeholders.

ENVIRONMENT=local
# SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@host:5432/privexa
DATABASE_URL=sqlite:///./privexa-dev.db
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Demo mode enables one-click demo sign-in, failure simulation and the guided walkthrough.
DEMO_MODE=true
DEMO_PASSWORD=privexa-demo

# Simulated hospital FHIR endpoints (server-side only — never exposed to the browser)
HOSPITAL_A_FHIR_URL=http://127.0.0.1:8081/fhir
HOSPITAL_B_FHIR_URL=http://127.0.0.1:8082/fhir
FHIR_TIMEOUT_SECONDS=4
FHIR_MAX_RETRIES=2

# Demo blockchain (local Hardhat network). The contract address is read from
# contracts/deployments/localhost.json unless ANCHOR_CONTRACT_ADDRESS is set.
CHAIN_RPC_URL=http://127.0.0.1:8545
ANCHOR_CONTRACT_ADDRESS=
# Leave empty for the local Hardhat node (uses its unlocked dev account). Required on any other network.
ANCHOR_PRIVATE_KEY=
ANCHOR_ENABLED=true

# Contact form delivery (optional). Without these, submissions are stored and the UI says so honestly.
CONTACT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=

# Web (Vite) — public values only
VITE_SITE_URL=http://localhost:5173
VITE_CONTACT_EMAIL=
